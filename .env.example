# ──── 2Brain AI Provider API Keys ────
# Configure at least one provider for AI note classification.
# Keys set here are read at build time via Vite (VITE_ prefix required).
# Users can also configure keys in Settings → AI Model (stored in localStorage).

# NVIDIA Build (default) — https://build.nvidia.com
# Model: google/gemma-4-31b-it
VITE_NVIDIA_API_KEY=""

# OpenRouter — https://openrouter.ai/keys
# Model: google/gemma-3-27b-it:free
VITE_OPENROUTER_API_KEY=""

# Groq — https://console.groq.com/keys
# Model: llama-3.1-8b-instant
VITE_GROQ_API_KEY=""

# Google AI Studio — https://aistudio.google.com/apikey
# Model: gemini-2.0-flash-lite
VITE_GOOGLE_API_KEY=""
